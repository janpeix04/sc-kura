<mjml>
  <mj-head>
    <mj-title>Restablecer contrase&#241;a</mj-title>

    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text color="#111827" line-height="1.5" />
      <mj-button background-color="#93C5FD" color="#111827" border-radius="8px" />
    </mj-attributes>

    <mj-style inline="inline">
      .text-muted { color: #6B7280; }
      .divider { border-color: #E5E7EB; }
      .warning { color: #B91C1C; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#F9FAFB">
    <mj-section background-color="#ffffff" padding="40px 20px">
      <mj-column>

        <mj-text align="center" font-size="28px" font-weight="700" color="#1E3A8A">
          Restablecer contrase&#241;a
        </mj-text>

        <mj-divider border-color="#93C5FD" border-width="2px" padding="10px 0" />

        <mj-text font-size="16px">
          &#161;Hola {{first_name}}!
        </mj-text>

        <mj-text font-size="16px" css-class="text-muted">
          Hemos recibido una solicitud para restablecer la contrase&#241;a de tu cuenta de KURA.
        </mj-text>

        <mj-text font-size="16px" css-class="text-muted">
          Haz clic en el bot&#243;n de abajo para crear una nueva contrase&#241;a.
        </mj-text>

        <mj-text font-size="16px" css-class="text-muted">
          Este enlace expirar&#225; en <strong>{{valid_hours}} horas</strong>.
        </mj-text>

        <mj-button
          href="{{link}}"
          font-size="16px"
          padding="15px 30px"
          background-color="#93C5FD"
          color="#111827"
        >
          Restablecer contrase&#241;a
        </mj-button>

        <mj-text font-size="14px" css-class="warning" padding-top="10px">
          Si no solicitaste este cambio, puedes ignorar este correo de forma segura.
        </mj-text>

        <mj-divider border-color="#E5E7EB" padding="20px 0" />

        <mj-text align="center" font-size="12px" color="#9CA3AF">
          &#169; {{current_year}} Kura. Todos los derechos reservados.
        </mj-text>

      </mj-column>
    </mj-section>
  </mj-body>
</mjml>