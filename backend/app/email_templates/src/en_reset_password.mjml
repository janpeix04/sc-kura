<mjml>
  <mj-head>
    <mj-title>Reset your password</mj-title>

    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />

      <mj-text color="#111827" line-height="1.5" />

      <mj-button
        background-color="#93C5FD"
        color="#111827"
        border-radius="8px"
      />
    </mj-attributes>

    <mj-style inline="inline">
      .text-muted {
        color: #6b7280;
      }
      .divider {
        border-color: #e5e7eb;
      }
      .warning {
        color: #b91c1c;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#F9FAFB">
    <mj-section background-color="#ffffff" padding="40px 20px">
      <mj-column>
        <mj-text
          align="center"
          font-size="28px"
          font-weight="700"
          color="#1E3A8A"
        >
          Reset your password
        </mj-text>

        <mj-divider
          border-color="#93C5FD"
          border-width="2px"
          padding="10px 0"
        />

        <mj-text font-size="16px"> Hello {{ first_name }}! </mj-text>

        <mj-text font-size="16px" css-class="text-muted">
          We received a request to reset your password for your KURA account.
        </mj-text>

        <mj-text font-size="16px" css-class="text-muted">
          Click the button below to create a new password.
        </mj-text>

        <mj-text font-size="16px" css-class="text-muted">
          This link will expire in <strong>{{ valid_hours }} hours</strong>.
        </mj-text>

        <mj-button
          href="{{link}}"
          font-size="16px"
          padding="15px 30px"
          background-color="#93C5FD"
          color="#111827"
        >
          Reset password
        </mj-button>

        <mj-text font-size="14px" css-class="warning" padding-top="10px">
          If you did not request a password reset, you can safely ignore this
          email.
        </mj-text>

        <mj-divider border-color="#E5E7EB" padding="20px 0" />

        <mj-text align="center" font-size="12px" color="#9CA3AF">
          &#160;&#169; {{ current_year }} Kura. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
