<mjml>
  <mj-head>
    <mj-title>Verifica tu correo electrónico</mj-title>

    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />

      <mj-text color="#111827" line-height="1.5" />

      <mj-button background-color="#93C5FD" color="#111827" border-radius="8px" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#F9FAFB">

    <mj-section background-color="#ffffff" padding="40px 20px">
      <mj-column>

        <mj-text align="center" font-size="28px" font-weight="700" color="#1E3A8A">
          Verifica tu direcci&#243;n de correo electr&#243;nico
        </mj-text>

        <mj-divider border-color="#93C5FD" border-width="2px" padding="10px 0" />

        <mj-text font-size="16px" color="#6B7280">
          &#161;Hola {{first_name}}!
        </mj-text>

        <mj-text font-size="16px" color="#6B7280">
          Est&#225;s a punto de empezar a disfrutar de KURA. Haz clic en el bot&#243;n de abajo para verificar tu direcci&#243;n de correo electr&#243;nico.
        </mj-text>

        <mj-text font-size="16px" color="#6B7280">
          Este enlace caduca en <strong>{{valid_hours}} horas</strong>.
        </mj-text>

        <mj-button href="{{link}}" font-size="16px" padding="15px 30px">
          Verificar mi correo electr&#243;nico
        </mj-button>

        <mj-divider border-color="#E5E7EB" padding="20px 0" />

        <mj-text align="center" font-size="12px" color="#9CA3AF">
          &#160;&#169; {{current_year}} Kura. Todos los derechos reservados.
        </mj-text>

      </mj-column>
    </mj-section>

  </mj-body>
</mjml>