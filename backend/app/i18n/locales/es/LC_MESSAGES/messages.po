#: app/tasks.py:22 app/tasks.py:33
#, python-format
msgid "Email sent to %(email_to)s"
msgstr "Correo electrónico enviado a %(email_to)s"

#: app/api/routes/auth.py:42
msgid ""
"A verification email has been sent. Please verify your email to continue."
" Don't forget to check your spam or junk folder."
msgstr ""
"Se ha enviado un correo electrónico de verificación. Por favor, verifica "
"tu correo electrónico para continuar. No olvides revisar la carpeta de "
"spam o correo no deseado."

#: app/api/routes/auth.py:56
msgid "Incorrect email or passowrd"
msgstr "Correo electrónico o contraseña incorrectos"

#: app/api/routes/auth.py:61 app/api/routes/auth.py:120
msgid ""
"Please verify your email address before logging in. Check your inbox for "
"a confirmation link."
msgstr ""
"Por favor, verifica tu dirección de correo electrónico antes de iniciar "
"sesión. Revisa tu bandeja de entrada para encontrar un enlace de "
"confirmación."

#: app/api/routes/auth.py:77
msgid "Invalid or expired verification link"
msgstr "Enlace de verificación no válido o caducado"

#: app/api/routes/auth.py:79
msgid "Email address already verified"
msgstr "La dirección de correo electrónico ya está verificada"

#: app/api/routes/auth.py:81
msgid "Your email address has been verified successfully"
msgstr "Tu dirección de correo electrónico ha sido verificada correctamente"

#: app/api/routes/auth.py:90 app/api/routes/auth.py:115 app/deps/auth.py:34
msgid "User not found"
msgstr "Usuario no encontrado"

#: app/api/routes/auth.py:103
msgid ""
"An email to reset your passowrd has been sent. Don't forget to check the "
"spam or junk folder."
msgstr ""
"Se ha enviado un correo electrónico para restablecer tu contraseña. No "
"olvides revisar la carpeta de spam o correo no deseado."

