#: app/tasks.py:22 app/tasks.py:33
#, python-format
msgid "Email sent to %(email_to)s"
msgstr "Correu electrònic enviat a %(email_to)s"

#: app/api/routes/auth.py:42
msgid ""
"A verification email has been sent. Please verify your email to continue."
" Don't forget to check your spam or junk folder."
msgstr ""
"S'ha enviat un correu de verificació. Si us plau, verifica el teu correu "
"electrònic per continuar. No oblidis comprovar la carpeta de correu "
"brossa o spam."

#: app/api/routes/auth.py:56
msgid "Incorrect email or passowrd"
msgstr "Correu electrònic o contrasenya incorrectes"

#: app/api/routes/auth.py:61 app/api/routes/auth.py:120
msgid ""
"Please verify your email address before logging in. Check your inbox for "
"a confirmation link."
msgstr ""
"Si us plau, verifica la teva adreça de correu electrònic abans d'iniciar "
"sessió. Comprova la safata d'entrada per trobar un enllaç de confirmació"

#: app/api/routes/auth.py:77
msgid "Invalid or expired verification link"
msgstr "Enllaç de verificació invàlid o caducat"

#: app/api/routes/auth.py:79
msgid "Email address already verified"
msgstr "L'adreça de correu electrònic ja està verificada"

#: app/api/routes/auth.py:81
msgid "Your email address has been verified successfully"
msgstr "La teva adreça de correu electrònic s'ha verificat correctament"

#: app/api/routes/auth.py:90 app/api/routes/auth.py:115 app/deps/auth.py:34
msgid "User not found"
msgstr "Usuari no trobat"

#: app/api/routes/auth.py:103
msgid ""
"An email to reset your passowrd has been sent. Don't forget to check the "
"spam or junk folder."
msgstr ""
"S'ha enviat un correu electrònic per restablir la contrasenya. No oblidis"
" de comprovar la carpeta de correu brossa o spam."

#: app/api/routes/auth.py:128
#, fuzzy
msgid "Password updated successfully"
msgstr "Contrasenya actualitzada correctament"

#: app/core/security.py:39
msgid "Invalid token payload"
msgstr "Contingut del token invàlid"

#: app/core/security.py:42
msgid "This link has expired"
msgstr "Aquest enllaç ha caducat"

#: app/core/security.py:44
msgid "Invalid token signature"
msgstr "Signatura del token invàlida"

#: app/core/security.py:46
msgid "Invalid token"
msgstr "Token invàlid"

#: app/deps/auth.py:29
msgid "Expired credentials"
msgstr "Credencials caducades"

#: app/deps/auth.py:31
msgid "Could not validate credentials"
msgstr "No s'han pogut validar les credencials"

#: app/deps/auth.py:46
msgid "User with this email already exists"
msgstr "Ja existeix un usuari amb aquest correu electrònic"

#~ msgid "User registered successfully"
#~ msgstr "Usuari registrat correctament"

