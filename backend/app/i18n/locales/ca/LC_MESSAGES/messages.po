msgid "User registered successfully"
msgstr "Usuari registrat correctament"

#: app/api/routes/auth.py:65
msgid "Incorrect email or passowrd"
msgstr "Correu electrònic o contrasenya incorrectes"

#: app/api/routes/auth.py:70
msgid ""
"Please verify your email address before logging in. Check your inbox for "
"a confirmation link."
msgstr "Si us plau, verifica la teva adreça de correu electrònic abans d'iniciar sessió. Comprova la teva safata d'entrada per trobar un enllaç de confirmació."

#: app/api/routes/auth.py:86
msgid "Incorrect email or password"
msgstr "Correu electrònic o contrasenya incorrectes"

#: app/api/routes/auth.py:88
msgid "Email address already verified"
msgstr "L'adreça de correu electrònic ja ha estat verificada"

#: app/api/routes/auth.py:89
msgid "Your email address has been verified successfully"
msgstr "La teva adreça de correu electrònic s'ha verificat correctament"

#: app/core/security.py:35
